{
  "trailingSlash": true,
  "redirects": [
    { "source": "/tienda", "destination": "/tiendas/", "permanent": true },
    { "source": "/tiendas-virtuales", "destination": "/tiendas/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|svg)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
